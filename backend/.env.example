# backend/.env.example
# Copy this file to backend/.env and fill in real values. Never commit .env.

# Supabase Postgres connection string, session pooler mode
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxx:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Single admin password check, no user table
ADMIN_SECRET=changeme

# Comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://vanene.online

# Resend, stubbed for now until domain is verified
RESEND_API_KEY=stub_not_configured_yet
RESEND_FROM_EMAIL=noreply@vanene.online
CONTACT_TO_EMAIL=kennedydsml@gmail.com

# Umami, added later when admin dashboard analytics are built
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# Signed cookie secret for admin session, separate from ADMIN_SECRET
SESSION_SECRET=changeme_too

# App environment, used to toggle debug behavior
ENVIRONMENT=development